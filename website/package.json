{
  "name": "bingi-site",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && vite build --ssr src/entry-server.tsx --outDir dist-ssr && vite build --ssr src/data/seo.ts --outDir dist-ssr --emptyOutDir false && vite build --ssr src/data/docs.ts --outDir dist-ssr --emptyOutDir false && node scripts/prerender.mjs",
    "lint": "oxlint",
    "preview": "vite preview",
    "build:preview": "tsc -b && vite build --mode single"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource/hind-siliguri": "^5.3.0",
    "@fontsource/instrument-sans": "^5.3.0",
    "@number-flow/react": "^0.6.2",
    "clsx": "^2.1.1",
    "lenis": "^1.3.27",
    "lucide-react": "^1.70.0",
    "motion": "^14.10.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.90.0",
    "tailwindcss": "^4.3.5",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "vite-plugin-singlefile": "^2.3.4"
  }
}
